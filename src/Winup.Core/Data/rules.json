// What winup cleans. To support another cache, add a rule here (and its label and note to strings.json).
// Levels: safe (rebuilds itself), standard (downloaded again), aggressive (apps get slower for a while or sign you out).
// kind: "contents" empties the folder and keeps it; "paths" deletes the matched files/folders.
// Paths: %LOCALAPPDATA% %APPDATA% %LOCALLOW% %TEMP% %USERPROFILE% %PROGRAMDATA% %WINDIR% %SYSTEMDRIVE%,
//        {a,b} alternatives and * inside one folder name. Links and junctions are never followed.
// Whatever a rule says, SafetyPolicy.cs only deletes inside its allowed places and never protected names.
// manual: listed, but only cleaned when you tick it yourself. processes: skipped while one of them runs.
{
  "version": 1,

  "electronCacheDirs": [
    "Cache", "Code Cache", "GPUCache", "DawnCache", "DawnGraphiteCache", "DawnWebGPUCache",
    "GrShaderCache", "ShaderCache", "GraphiteDawnCache", "CachedData", "CachedExtensionVSIXs"
  ],

  // Readable names for apps found by folder layout (any other Chromium/Electron/WebView2 app with a cache).
  "appNames": {
    "Olk": "Outlook (new)",
    "Spark Desktop": "Spark",
    "G HUB": "Logitech G HUB",
    "Claude": "Claude"
  },

  // Electron apps: only the cache folders above (also in Default\ and Partitions\*\), never User\ (settings) or Backups\ (unsaved files).
  "electronApps": [
    { "folder": "%APPDATA%\\Code", "name": "Visual Studio Code", "processes": ["Code"] },
    { "folder": "%APPDATA%\\Code - Insiders", "name": "Visual Studio Code - Insiders", "processes": ["Code - Insiders"] },
    { "folder": "%APPDATA%\\Cursor", "name": "Cursor", "processes": ["Cursor"] },
    { "folder": "%APPDATA%\\Windsurf", "name": "Windsurf", "processes": ["Windsurf"] },
    { "folder": "%APPDATA%\\VSCodium", "name": "VSCodium", "processes": ["VSCodium"] },
    { "folder": "%APPDATA%\\Claude", "name": "Claude", "processes": ["claude"] },
    { "folder": "%APPDATA%\\Slack", "name": "Slack", "processes": ["slack"] },
    { "folder": "%APPDATA%\\discord", "name": "Discord", "processes": ["Discord"] },
    { "folder": "%APPDATA%\\Notion", "name": "Notion", "processes": ["Notion"] },
    { "folder": "%APPDATA%\\obsidian", "name": "Obsidian", "processes": ["Obsidian"] },
    { "folder": "%APPDATA%\\Signal", "name": "Signal", "processes": ["Signal"] },
    { "folder": "%APPDATA%\\Postman", "name": "Postman", "processes": ["Postman"] },
    { "folder": "%APPDATA%\\Telegram Desktop", "name": "Telegram", "processes": ["Telegram"] },
    { "folder": "%APPDATA%\\WhatsApp", "name": "WhatsApp", "processes": ["WhatsApp"] },
    { "folder": "%APPDATA%\\Figma", "name": "Figma", "processes": ["Figma"] },
    { "folder": "%APPDATA%\\GitHub Desktop", "name": "GitHub Desktop", "processes": ["GitHubDesktop"] },
    { "folder": "%APPDATA%\\Microsoft\\Teams", "name": "Microsoft Teams (classic)", "processes": ["Teams"] }
  ],

  "rules": [
    // ---------------------------------------------------------------- temporary files
    { "id": "temp.user", "level": "safe", "category": "temp", "kind": "contents",
      "label": "Temporary files (%TEMP%)",
      "note": "Leftovers of programs and installers. Files changed in the last 24 hours and files in use stay.",
      "paths": ["%TEMP%"], "minAgeHours": 24 },
    { "id": "temp.windows", "level": "safe", "category": "temp", "kind": "contents", "admin": true,
      "label": "Windows temporary files",
      "note": "Temporary files of Windows and installers. Files changed in the last 24 hours and files in use stay.",
      "paths": ["%WINDIR%\\Temp"], "minAgeHours": 24 },
    { "id": "temp.thumbnails", "level": "safe", "category": "temp", "kind": "paths",
      "label": "Explorer thumbnail and icon cache",
      "note": "Explorer creates thumbnails again. Files it holds open right now are skipped.",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\{thumbcache_*.db,iconcache_*.db}"] },
    { "id": "temp.inetcache", "level": "safe", "category": "temp", "kind": "contents",
      "label": "WinINet cache (INetCache)",
      "note": "Internet cache of old Internet Explorer components and apps that use WinINet.",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache"] },
    { "id": "temp.squirrel", "level": "safe", "category": "temp", "kind": "contents",
      "label": "Squirrel installer leftovers",
      "note": "Left over from installing or updating Discord, Teams and similar apps.",
      "paths": ["%LOCALAPPDATA%\\SquirrelTemp"] },

    // ---------------------------------------------------------------- graphics driver
    { "id": "gpu.directx", "level": "safe", "category": "gpu", "kind": "contents",
      "label": "DirectX shader cache",
      "note": "The driver builds shaders again; the first start of a game may stutter a little.",
      "paths": ["%LOCALAPPDATA%\\D3DSCache"] },
    { "id": "gpu.nvidia", "level": "safe", "category": "gpu", "kind": "contents",
      "label": "NVIDIA shader cache",
      "note": "The driver builds shaders again; the first start of a game may stutter a little.",
      "paths": ["%LOCALAPPDATA%\\NVIDIA\\{DXCache,GLCache,OptixCache}", "%LOCALLOW%\\NVIDIA\\PerDriverVersion\\{DXCache,GLCache}",
                "%LOCALAPPDATA%\\NVIDIA Corporation\\NV_Cache"] },
    { "id": "gpu.amd", "level": "safe", "category": "gpu", "kind": "contents",
      "label": "AMD shader cache",
      "note": "The driver builds shaders again; the first start of a game may stutter a little.",
      "paths": ["%LOCALAPPDATA%\\AMD\\{DxCache,DxcCache,GLCache,VkCache,OglCache,Dx9Cache}"] },
    { "id": "gpu.intel", "level": "safe", "category": "gpu", "kind": "contents",
      "label": "Intel shader cache",
      "note": "The driver builds shaders again; the first start of a game may stutter a little.",
      "paths": ["%LOCALAPPDATA%\\Intel\\ShaderCache", "%LOCALLOW%\\Intel\\ShaderCache"] },
    { "id": "gpu.nvidia_downloads", "level": "standard", "category": "gpu", "kind": "contents", "admin": true,
      "label": "NVIDIA driver installers already downloaded",
      "note": "Files NVIDIA App downloaded to install drivers. Not needed after the install.",
      "paths": ["%PROGRAMDATA%\\NVIDIA Corporation\\Downloader"], "processes": ["NVIDIA App"] },
    { "id": "gpu.nvidia_ota", "level": "standard", "category": "gpu", "kind": "contents", "admin": true,
      "label": "NVIDIA App update packages (ota-artifacts)",
      "note": "Driver and NVIDIA App packages from updates that are already installed. The next update downloads what it needs.",
      "paths": ["%PROGRAMDATA%\\NVIDIA Corporation\\NVIDIA App\\UpdateFramework\\ota-artifacts"], "processes": ["NVIDIA App"] },
    { "id": "gpu.nvidia_extract", "level": "safe", "category": "gpu", "kind": "paths", "admin": true,
      "label": "Unpacked NVIDIA driver (C:\\NVIDIA)",
      "note": "Temporary unpacked copy of a driver installer.",
      "paths": ["%SYSTEMDRIVE%\\NVIDIA"] },

    // ---------------------------------------------------------------- crash dumps and error reports
    { "id": "dumps.apps", "level": "safe", "category": "dumps", "kind": "contents",
      "label": "App crash dumps (CrashDumps)",
      "note": "Reports about crashed programs. Only needed for debugging.",
      "paths": ["%LOCALAPPDATA%\\CrashDumps"] },
    { "id": "dumps.wer_user", "level": "safe", "category": "dumps", "kind": "contents",
      "label": "Windows error reports (your account)",
      "note": "Reports about crashed programs. Only needed for debugging.",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Windows\\WER"] },
    { "id": "dumps.wer_system", "level": "safe", "category": "dumps", "kind": "contents", "admin": true,
      "label": "Windows error reports (system)",
      "note": "Reports about crashed programs. Only needed for debugging.",
      "paths": ["%PROGRAMDATA%\\Microsoft\\Windows\\WER"] },
    { "id": "dumps.minidump", "level": "safe", "category": "dumps", "kind": "contents", "admin": true,
      "label": "Blue screen minidumps",
      "note": "Reports about system crashes. Only needed for debugging.",
      "paths": ["%WINDIR%\\Minidump"] },
    { "id": "dumps.memory", "level": "safe", "category": "dumps", "kind": "paths", "admin": true,
      "label": "Full memory dump (MEMORY.DMP)",
      "note": "Reports about system crashes. Only needed for debugging.",
      "paths": ["%WINDIR%\\MEMORY.DMP"] },
    { "id": "dumps.livekernel", "level": "safe", "category": "dumps", "kind": "contents", "admin": true,
      "label": "Kernel reports (LiveKernelReports)",
      "note": "Dumps of driver hangs, often the graphics driver. Only needed for debugging.",
      "paths": ["%WINDIR%\\LiveKernelReports"] },

    // ---------------------------------------------------------------- game launchers
    { "id": "games.steam_web", "level": "safe", "category": "games", "kind": "contents",
      "label": "Steam web cache",
      "note": "Cache of the Steam client's built-in browser. Games and saves are not touched.",
      "paths": ["%LOCALAPPDATA%\\Steam\\htmlcache"], "processes": ["steam", "steamwebhelper"] },
    { "id": "games.epic_web", "level": "safe", "category": "games", "kind": "contents",
      "label": "Epic Games web cache and logs",
      "note": "Cache and logs of the Epic Games Launcher. Games are not touched.",
      "paths": ["%LOCALAPPDATA%\\EpicGamesLauncher\\Saved\\{webcache*,Logs}"], "processes": ["EpicGamesLauncher", "EpicWebHelper"] },
    { "id": "games.battlenet", "level": "safe", "category": "games", "kind": "contents",
      "label": "Battle.net cache",
      "note": "Cache of the Battle.net launcher. Games are not touched.",
      "paths": ["%LOCALAPPDATA%\\Battle.net\\{Cache,BrowserCaches}"], "processes": ["Battle.net"] },
    { "id": "games.ea", "level": "safe", "category": "games", "kind": "contents",
      "label": "EA app cache",
      "note": "Cache of the EA app. Games are not touched.",
      "paths": ["%LOCALAPPDATA%\\Electronic Arts\\EA Desktop\\cache"], "processes": ["EADesktop"] },

    // ---------------------------------------------------------------- developer tools
    { "id": "dev.npm", "level": "standard", "category": "dev", "kind": "contents",
      "label": "npm cache",
      "note": "Downloaded again by the next npm install (takes time and traffic).",
      "paths": ["%LOCALAPPDATA%\\npm-cache\\_cacache", "%APPDATA%\\npm-cache\\_cacache"] },
    { "id": "dev.yarn", "level": "standard", "category": "dev", "kind": "contents",
      "label": "Yarn cache",
      "note": "Downloaded again by the next install (takes time and traffic).",
      "paths": ["%LOCALAPPDATA%\\Yarn\\Cache"] },
    { "id": "dev.pip", "level": "standard", "category": "dev", "kind": "contents",
      "label": "pip cache",
      "note": "Downloaded again by the next install (takes time and traffic).",
      "paths": ["%LOCALAPPDATA%\\pip\\Cache"] },
    { "id": "dev.uv", "level": "standard", "category": "dev", "kind": "contents",
      "label": "uv cache",
      "note": "Downloaded again by the next install (takes time and traffic).",
      "paths": ["%LOCALAPPDATA%\\uv\\cache"], "processes": ["uv"] },
    { "id": "dev.nuget_http", "level": "standard", "category": "dev", "kind": "contents",
      "label": "NuGet HTTP cache",
      "note": "Downloaded again by the next restore (takes time and traffic).",
      "paths": ["%LOCALAPPDATA%\\NuGet\\{v3-cache,plugins-cache}"] },
    { "id": "dev.go", "level": "standard", "category": "dev", "kind": "contents",
      "label": "Go build cache",
      "note": "The next build is slower once.",
      "paths": ["%LOCALAPPDATA%\\go-build"] },
    { "id": "dev.gradle", "level": "standard", "category": "dev", "kind": "contents",
      "label": "Gradle caches",
      "note": "Downloaded again by the next build. gradle.properties is not touched.",
      "paths": ["%USERPROFILE%\\.gradle\\caches"], "processes": ["java"] },
    { "id": "dev.cargo", "level": "standard", "category": "dev", "kind": "contents",
      "label": "Cargo registry cache",
      "note": "Downloaded again by the next build (takes time and traffic).",
      "paths": ["%USERPROFILE%\\.cargo\\registry\\{cache,src}"], "processes": ["cargo"] },
    { "id": "dev.nuget_packages", "level": "aggressive", "category": "dev", "kind": "contents", "manual": true,
      "label": "NuGet packages folder",
      "note": "All restored packages. Every project restores them again; close Visual Studio and IDEs first.",
      "paths": ["%USERPROFILE%\\.nuget\\packages"], "processes": ["devenv", "rider64"] },
    { "id": "dev.maven", "level": "aggressive", "category": "dev", "kind": "contents", "manual": true,
      "label": "Maven repository",
      "note": "Downloaded again by the next build. Your own mvn install builds exist only here. settings.xml is not touched.",
      "paths": ["%USERPROFILE%\\.m2\\repository"], "processes": ["java"] },
    { "id": "dev.playwright", "level": "aggressive", "category": "dev", "kind": "contents", "manual": true,
      "label": "Playwright browsers",
      "note": "Browsers downloaded by Playwright. npx playwright install brings them back.",
      "paths": ["%LOCALAPPDATA%\\ms-playwright"] },

    // ---------------------------------------------------------------- browsers (cache only: never profiles, passwords, history, cookies)
    { "id": "browser.chrome", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Google Chrome cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{Default,Profile *,Guest Profile,System Profile}\\{Cache,Code Cache,GPUCache,DawnCache,DawnGraphiteCache,DawnWebGPUCache}",
                "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\{ShaderCache,GrShaderCache,GraphiteDawnCache,component_crx_cache}"],
      "processes": ["chrome"] },
    { "id": "browser.edge", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Microsoft Edge cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\{Default,Profile *,Guest Profile,System Profile}\\{Cache,Code Cache,GPUCache,DawnCache,DawnGraphiteCache,DawnWebGPUCache}",
                "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\{ShaderCache,GrShaderCache,GraphiteDawnCache,component_crx_cache}"],
      "processes": ["msedge"] },
    { "id": "browser.brave", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Brave cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\{Default,Profile *,Guest Profile,System Profile}\\{Cache,Code Cache,GPUCache,DawnCache,DawnGraphiteCache,DawnWebGPUCache}",
                "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\{ShaderCache,GrShaderCache,GraphiteDawnCache,component_crx_cache}"],
      "processes": ["brave"] },
    { "id": "browser.vivaldi", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Vivaldi cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Vivaldi\\User Data\\{Default,Profile *,Guest Profile,System Profile}\\{Cache,Code Cache,GPUCache,DawnCache,DawnGraphiteCache,DawnWebGPUCache}",
                "%LOCALAPPDATA%\\Vivaldi\\User Data\\{ShaderCache,GrShaderCache,GraphiteDawnCache,component_crx_cache}"],
      "processes": ["vivaldi"] },
    { "id": "browser.yandex", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Yandex Browser cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Yandex\\YandexBrowser\\User Data\\{Default,Profile *,Guest Profile,System Profile}\\{Cache,Code Cache,GPUCache,DawnCache,DawnGraphiteCache,DawnWebGPUCache}",
                "%LOCALAPPDATA%\\Yandex\\YandexBrowser\\User Data\\{ShaderCache,GrShaderCache,GraphiteDawnCache,component_crx_cache}"],
      "processes": ["browser"] },
    { "id": "browser.opera", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Opera cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Opera Software\\{Opera Stable,Opera GX Stable}\\{Cache,Code Cache,GPUCache}"],
      "processes": ["opera"] },
    { "id": "browser.firefox", "level": "aggressive", "category": "browsers", "kind": "contents",
      "label": "Firefox cache",
      "note": "Sites load a little slower at first. Passwords, history, bookmarks, cookies and tabs are not touched.",
      "paths": ["%LOCALAPPDATA%\\Mozilla\\Firefox\\Profiles\\*\\{cache2,startupCache,shader-cache}"],
      "processes": ["firefox"] }
  ]
}
