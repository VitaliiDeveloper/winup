<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winup.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winup.App"
    Title="winup">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="winup" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- header -->
        <Grid Grid.Row="1" Padding="28,4,28,16" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="LangBox" MinWidth="130" SelectionChanged="LangBox_SelectionChanged" />
                <Button x:Name="RescanButton" Click="RescanButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock x:Name="RescanText" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- summary cards -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="FoundCaption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="FoundValue" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SelectedCaption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SelectedValue" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LevelCaption" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="LevelBox" HorizontalAlignment="Stretch" SelectionChanged="LevelBox_SelectionChanged" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- list -->
        <ListView x:Name="List" Grid.Row="2" Padding="16,0,16,8" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CandidateItem">
                    <Grid Padding="14,10,18,10" ColumnSpacing="14" CornerRadius="6"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                          Opacity="{x:Bind RowOpacity}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox MinWidth="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" MinWidth="96" Padding="10,3" CornerRadius="10" VerticalAlignment="Center" Background="{x:Bind LevelBackground}">
                            <TextBlock Text="{x:Bind LevelText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{x:Bind LevelForeground}" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind BlockedVisibility}">
                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{x:Bind Blocked}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind Size}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="BusyPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock x:Name="BusyText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- footer -->
        <Grid Grid.Row="3" Padding="28,12,28,20" ColumnSpacing="16"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" VerticalAlignment="Center" />
            <Button x:Name="CleanButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Padding="20,9" VerticalAlignment="Center" Click="CleanButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Name="CleanText" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
